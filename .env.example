# ---- Model provider (pick one; CAF_LLM_PROVIDER=auto uses the first one configured) ----
CAF_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# Claude on Microsoft Foundry (Azure): the key and endpoint from the deployment's page in the Foundry portal.
# The Target URI (.../anthropic/v1/messages) or the base (.../anthropic/) both work.
# ANTHROPIC_FOUNDRY_API_KEY=
# ANTHROPIC_FOUNDRY_BASE_URL=https://<resource>.services.ai.azure.com/anthropic/
# Deployment names per tier (defaults: claude-sonnet-5-5 for fast/balanced, claude-opus-5 for pro/complex)
# FOUNDRY_DEPLOYMENT_FAST=claude-sonnet-5-5
# FOUNDRY_DEPLOYMENT_PRO=claude-opus-5
# Model routing profile: economy (one tier down) | balanced | quality (one tier up); see config/model_routing.yaml
# CAF_MODEL_PROFILE=balanced
# Throttling shared by all agents, per deployment: calls in flight, calls per minute, tokens per minute (0 = no limit)
# CAF_LLM_MAX_CONCURRENT=3
# CAF_LLM_RPM=40
# CAF_LLM_TPM=0
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_DEPLOYMENT_FAST=gpt-5-mini
# AZURE_DEPLOYMENT_BALANCED=gpt-5
# OPENAI_API_KEY=
# CAF_BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_BALANCED=<model or inference-profile id>
# OLLAMA_HOST=http://localhost:11434
# Override any tier directly: CAF_MODEL_FAST / CAF_MODEL_BALANCED / CAF_MODEL_PRO / CAF_MODEL_COMPLEX

# ---- Connectors (defaults run fully offline on the Meridian Mutual demo data) ----
CAF_SEARCH_PROVIDER=fixture          # none | fixture | serpapi | brave | tavily
SEARCH_API_KEY=
CAF_ANALYTICS_PROVIDER=csv           # csv | ga4 | adobe_analytics
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
ADOBE_ANALYTICS_COMPANY_ID=
ADOBE_ANALYTICS_RSID=
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
CAF_KEYWORD_PROVIDER=csv             # none | csv | gsc | dataforseo
CAF_EXPERIMENTS_PROVIDER=json        # json | optimizely | adobe_target
CAF_CMS_PROVIDER=file                # file | aem | contentful | wordpress
CAF_ESP_PROVIDER=file                # file | braze | mailchimp | ajo
CAF_TASKS_PROVIDER=json_file         # json_file | jira | azure_devops
CAF_TRANSLATION_PROVIDER=llm         # llm | deepl | azure
CAF_WAREHOUSE_PROVIDER=duckdb        # duckdb | sqlalchemy
CAF_WAREHOUSE_URL=

# ---- Governance ----
CAF_AUTO_APPROVE=false               # publish-type actions wait for a human unless true
CAF_ALLOW_REQUEST_AUTO_APPROVE=false # let API callers skip approval gates per request (mandatory gates still hold)
CAF_PUBLIC_URL=http://localhost:8080 # used for short links (/r/{code})

# ---- Agent Shop ----
# Where the shop keeps customers, keys, subscriptions and usage (SQLite). Default: <home>/data
# CAF_DATA_DIR=data
# Encrypts a customer's model credential when a policy carries it inline (any long passphrase). Without it,
# policies must name an environment variable on this server (api_key_env) instead.
CAF_SECRET_KEY=
# Branding shown on the storefront, console and API (defaults: CX Nova Agent Orchestration Layer, by Coforge)
# CAF_PRODUCT_NAME=CX Nova Agent Orchestration Layer
# CAF_COMPANY=Coforge

# ---- Hosting ----
# Bind address and port for `caf serve` (0.0.0.0 to serve other machines; then set CAF_API_TOKEN)
# CAF_HOST=0.0.0.0
# CAF_PORT=8080
# Behind a reverse proxy that serves the shop under a prefix (https://host/agentshop/...), set the prefix here
# CAF_ROOT_PATH=/agentshop
# Reverse-proxy addresses whose X-Forwarded-* headers are trusted (default 127.0.0.1; * = any)
# CAF_FORWARDED_ALLOW_IPS=127.0.0.1

# ---- Service security (REST / MCP / A2A; the CLI is not restricted) ----
# Operator token (admin on the API and the shop admin console): required for docker compose or any non-local client
# (generate one with: openssl rand -hex 32). Customers never get this token; they get keys issued by the shop.
CAF_API_TOKEN=
# Comma-separated browser origins allowed to call the API (none by default)
CAF_CORS_ORIGINS=
# Optional allowlist of hosts agents may fetch, e.g. www.client.com,*.client.com
CAF_ALLOWED_HOSTS=
CAF_ALLOW_PRIVATE_NETWORK=false      # true lets agents fetch loopback/private/link-local hosts (intranet audits)
CAF_ALLOW_ANY_LOCAL_FILE=false       # true lets service callers read any local file (default: sample_data and runs only)

# ---- Agent packs (config/packs/*.yaml: Campaign Studio, ARM SDLC Factory) ----
# Leave packs out: ids separated by commas (campaign_studio, arm_sdlc), or * for none
# CAF_PACKS_DISABLED=
# Campaign Studio as the home of its own agents: operator runs that carry campaign_id are served by the studio
# itself instead of being modelled here. The address is the studio's own (port 8787 by default); the passcode is
# the studio's APP_PASSCODE. Customer runs never use it.
# CAF_PACK_CAMPAIGN_STUDIO_URL=http://127.0.0.1:8787
# CAF_PACK_CAMPAIGN_STUDIO_PASSCODE=

# ---- Vendor connectors (only needed for the providers you switch on; see docs/CONNECTORS.md) ----
# Adobe (Analytics, Target, Journey Optimizer): ADOBE_CLIENT_ID, ADOBE_CLIENT_SECRET, ADOBE_ORG_ID, ADOBE_TARGET_TENANT, AJO_SANDBOX
# AEM: CAF_CMS_PROVIDER=aem, CAF_CMS_BASE_URL, AEM_ACCESS_TOKEN, AEM_PARENT_PATH, AEM_MODEL_PATH
# Contentful: CONTENTFUL_SPACE_ID, CONTENTFUL_MANAGEMENT_TOKEN   WordPress: WP_USERNAME, WP_APP_PASSWORD
# Braze: CAF_ESP_API_KEY, BRAZE_REST_ENDPOINT   Mailchimp: CAF_ESP_API_KEY, MAILCHIMP_LIST_ID
# Jira: CAF_TASKS_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN, JIRA_PROJECT_KEY   Azure DevOps: ADO_ORGANIZATION, ADO_PROJECT, ADO_PAT
# Optimizely: OPTIMIZELY_API_TOKEN, OPTIMIZELY_PROJECT_ID   LaunchDarkly: LAUNCHDARKLY_API_TOKEN, LAUNCHDARKLY_PROJECT_KEY, LAUNCHDARKLY_ENVIRONMENT
# Zoom: ZOOM_ACCOUNT_ID, ZOOM_CLIENT_ID, ZOOM_CLIENT_SECRET, ZOOM_WEBINAR_ID   Clarity: CLARITY_API_TOKEN
# DeepL / Azure Translator: CAF_TRANSLATION_API_KEY, AZURE_TRANSLATOR_REGION   Qdrant: QDRANT_URL, QDRANT_API_KEY
# DataForSEO: DATAFORSEO_LOGIN, DATAFORSEO_PASSWORD   CRM: CAF_CRM_PROVIDER, SALESFORCE_*, HUBSPOT_ACCESS_TOKEN
