{
  "experiments": [
    {
      "id": "exp-hero-cta",
      "name": "Home insurance hero CTA copy",
      "status": "completed",
      "platform": "optimizely",
      "page_url": "https://www.meridian-mutual.example/products/home-insurance.html",
      "hypothesis": "If we change the hero call to action from 'Get a quote' to 'See my price in 2 minutes', then quote starts will increase, because the new copy sets a clear time expectation and promises a personal price instead of a sales conversation.",
      "primary_metric": {
        "id": "quote_start",
        "name": "Quote start rate",
        "type": "conversion",
        "event": "quote_start"
      },
      "secondary_metrics": [
        {
          "id": "quote_complete",
          "name": "Quote completion rate",
          "type": "conversion",
          "event": "quote_complete"
        },
        {
          "id": "revenue_per_visitor",
          "name": "Revenue per visitor",
          "type": "revenue",
          "event": "policy_purchase"
        }
      ],
      "guardrail_metrics": [
        {
          "id": "bounce_rate",
          "name": "Bounce rate",
          "type": "conversion",
          "event": "bounce"
        },
        {
          "id": "form_error_rate",
          "name": "Quote form error rate",
          "type": "conversion",
          "event": "form_error"
        }
      ],
      "variants": [
        {
          "id": "control",
          "name": "Get a quote",
          "allocation": 50,
          "is_control": true,
          "description": "Existing hero button: 'Get a quote'."
        },
        {
          "id": "treatment",
          "name": "See my price in 2 minutes",
          "allocation": 50,
          "is_control": false,
          "description": "Hero button copy changed to 'See my price in 2 minutes'; styling unchanged."
        }
      ],
      "traffic_allocation": 100,
      "audience": {
        "devices": [
          "desktop",
          "mobile"
        ],
        "geo": [
          "US"
        ],
        "conditions": [
          "All visitors to the home insurance product page",
          "Exclude logged-in members"
        ]
      },
      "start_date": "2026-08-01",
      "end_date": "2026-08-28",
      "planned_duration_days": 28,
      "baseline_rate": 0.039,
      "mde": 0.13,
      "expected_daily_visitors": 1800,
      "qa_links": [
        "https://www.meridian-mutual.example/products/home-insurance.html?caf_preview=exp-hero-cta&variant=control",
        "https://www.meridian-mutual.example/products/home-insurance.html?caf_preview=exp-hero-cta&variant=treatment"
      ],
      "instrumentation": {
        "events": [
          "quote_start",
          "quote_complete",
          "policy_purchase",
          "bounce",
          "form_error"
        ]
      },
      "owner": "Jordan Pike"
    },
    {
